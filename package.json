{
  "name": "hollowsurv",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Bullet-heaven / survivors-like vertical slice. Phaser 4 + bitECS + Zustand + React 19 + Vite + TS strict.",
  "scripts": {
