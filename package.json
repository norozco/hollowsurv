    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
